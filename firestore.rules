rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'admin']) ||
        request.auth.token.email in ['warisulislam371@gmail.com', 'admin@medbazarhelnex.shop']
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection (PII Protection)
    match /users/{userId} {
      allow get, list: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId) &&
        request.resource.data.role in ['customer', 'vendor'] &&
        request.resource.data.email == request.auth.token.email;
      allow update: if isSignedIn() && (
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isVerified'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Vendors Collection
    match /vendors/{vendorId} {
      allow read: if true; // Public directory info for products & store pages
      allow create: if isSignedIn() && (request.auth.uid == vendorId || request.resource.data.id == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (
        (request.auth.uid == vendorId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'trustSeal', 'isVerifiedSeller'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Vendor Documents (Strict PII & Document Storage)
    match /vendorDocuments/{docId} {
      allow read: if isSignedIn() && (
        resource.data.vendorId == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.vendorId == request.auth.uid || isAdmin()
      ) && request.resource.data.fileUrl.size() > 0;
      allow update: if isSignedIn() && (
        (resource.data.vendorId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fileUrl', 'fileSize', 'uploadedAt', 'status'])) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.vendorId == request.auth.uid || isAdmin());
    }

    // Product Images Collection
    match /productImages/{imageId} {
      allow read: if true; // Public product gallery viewing
      allow create: if isSignedIn() && (
        request.resource.data.vendorId == request.auth.uid || isAdmin()
      );
      allow update: if isSignedIn() && (
        (resource.data.vendorId == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.vendorId == request.auth.uid || isAdmin());
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.resource.data.vendorId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (
        (resource.data.vendorId == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'approvedBy', 'approvedAt'])) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.vendorId == request.auth.uid || isAdmin());
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.vendorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.vendorId == request.auth.uid ||
        isAdmin()
      );
    }

    // RFQs Collection
    match /rfqs/{rfqId} {
      allow read: if true;
      allow create, update: if isSignedIn();
    }

    // Quotations Collection
    match /quotations/{quotationId} {
      allow read: if true;
      allow create, update: if isSignedIn();
    }

    // Support Tickets Collection
    match /tickets/{ticketId} {
      allow read, write: if isSignedIn();
    }

    // Categories & Brands
    match /categories/{catId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /categoryRequests/{reqId} {
      allow read, write: if isSignedIn();
    }

    match /brandRequests/{reqId} {
      allow read, write: if isSignedIn();
    }

    // Payment & WhatsApp Settings
    match /payment_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /whatsapp_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /whatsapp_click_logs/{logId} {
      allow read, create: if true;
    }

    match /clearance_requests/{reqId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /promo_banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /price_alerts/{alertId} {
      allow read, write: if true;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
